#!/bin/sh
set -e

# Create the unprivileged service account before the generated systemd
# fragments start the unit. sysusers also runs at boot, so this is a
# belt-and-braces step for the first install on a running system.
if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers weather-pi.conf >/dev/null 2>&1 || true
fi

#DEBHELPER#

exit 0
