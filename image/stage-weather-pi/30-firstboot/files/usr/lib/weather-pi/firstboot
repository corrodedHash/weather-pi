def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--config",
        help=f"provisioning file (default: {DEFAULT_CONFIG} under --root)",
    )
    parser.add_argument(
        "--root",
        default=os.environ.get("WEATHER_PI_ROOT", "/"),
        help="filesystem prefix; WEATHER_PI_ROOT is used when the flag is absent",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="validate and log changes without writing anything",
    )
    parser.add_argument(
        "--no-commands",
        action="store_true",
        help="do not run nmcli, systemctl, ssh-keygen, or other commands",
    )
    args = parser.parse_args(argv)

    logging.basicConfig(
        level=logging.INFO,
        format="weather-pi-firstboot: %(levelname)s: %(message)s",
        stream=sys.stderr,
    )

    root = Path(args.root).expanduser().resolve()
    if args.config:
        config_path = Path(args.config).expanduser()
        if not config_path.is_absolute():
            config_path = root / config_path
        elif root != Path("/") and not config_path.is_relative_to(root):
            config_path = root / str(config_path).lstrip("/")
    else:
        config_path = root / DEFAULT_CONFIG.lstrip("/")

    ctx = Context(root=root, dry_run=args.dry_run, no_commands=args.no_commands)
    sentinel = ctx.path(SENTINEL)
    if sentinel.exists():
        LOG.info("provisioning already completed (%s); nothing to do", sentinel)
        return 0
    if not config_path.is_file():
        LOG.info("no provisioning file at %s; nothing to do", config_path)
        return 0

    try:
        config = load_provisioning(config_path)
        LOG.info("applying provisioning file %s", config_path)
        if config.hostname is not None:
            apply_hostname(ctx, config.hostname)
        if config.wifi is not None:
            apply_wifi(ctx, config.wifi)
        if config.ssh_keys is not None:
            apply_ssh_keys(ctx, config.ssh_keys)
        if config.tunnel is not None:
            apply_tunnel(ctx, config.tunnel)
        sanitize_config(ctx, config_path, config)

        ensure_directory(ctx, ctx.path("/var/lib/weather-pi"), 0o755)
        write_text(ctx, sentinel, "provisioned\n", 0o644)
        if ctx.dry_run:
            LOG.info("dry run: validation succeeded; no changes were made")
        else:
            LOG.info("provisioning completed")
        return 0
    except ConfigError as error:
        LOG.error("invalid provisioning configuration: %s", error)
        return 2
    except OSError as error:
        LOG.error("provisioning failed: %s", error)
        return 1


if __name__ == "__main__":
    sys.exit(main())
