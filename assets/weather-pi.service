[Unit]
Description=weather-pi e-ink display service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/weather-pi greeter
Restart=on-failure
RestartSec=5s
User=weather-pi
Group=weather-pi
SupplementaryGroups=spi gpio
LimitNOFILE=4096
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
